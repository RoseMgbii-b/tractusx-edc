    "mappings": {
      "properties": {
        "id":            { "type": "keyword" },
        "timestamp":     { "type": "date" },
        "category":      { "type": "keyword" },
        "event_name":    { "type": "keyword" },
        "outcome":       { "type": "keyword" },
